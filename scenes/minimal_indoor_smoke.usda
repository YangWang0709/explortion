#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Environment"
    {
        def Cube "Floor"
        {
            double3 xformOp:translate = (0, 0, -0.05)
            float3 xformOp:scale = (6, 4, 0.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Wall_North"
        {
            double3 xformOp:translate = (0, 4, 1)
            float3 xformOp:scale = (6, 0.08, 1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Wall_South"
        {
            double3 xformOp:translate = (0, -4, 1)
            float3 xformOp:scale = (6, 0.08, 1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Wall_West"
        {
            double3 xformOp:translate = (-6, 0, 1)
            float3 xformOp:scale = (0.08, 4, 1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Wall_East"
        {
            double3 xformOp:translate = (6, 0, 1)
            float3 xformOp:scale = (0.08, 4, 1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "RoomDivider_A"
        {
            double3 xformOp:translate = (-2, 0, 1)
            float3 xformOp:scale = (0.06, 2.6, 1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "RoomDivider_B"
        {
            double3 xformOp:translate = (2, 0, 1)
            float3 xformOp:scale = (0.06, 2.6, 1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Obstacle_Table"
        {
            double3 xformOp:translate = (0, 1.4, 0.35)
            float3 xformOp:scale = (0.7, 0.45, 0.35)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Obstacle_Box"
        {
            double3 xformOp:translate = (3.4, -1.2, 0.45)
            float3 xformOp:scale = (0.45, 0.45, 0.45)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "RobotStart"
    {
        double3 xformOp:translate = (-4.5, -2.8, 0.25)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "RobotBody"
        {
            float3 xformOp:scale = (0.25, 0.18, 0.12)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }

    def Camera "ReviewCamera"
    {
        double3 xformOp:translate = (0, -8, 5.5)
        double3 xformOp:rotateXYZ = (60, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        float focalLength = 24
        float horizontalAperture = 20.955
    }
}
